<Window x:Class="nah_the_search.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:local="clr-namespace:nah_the_search"
	mc:Ignorable="d"
	Title="MainWindow" Height="450" Width="800" 
	WindowStyle="None"
	WindowStartupLocation="CenterScreen"
	ResizeMode="NoResize"
	AllowsTransparency="True"
	Background="Transparent"
	ShowInTaskbar="False"
	>

<Window.DataContext>
	<local:MainViewModel/>
</Window.DataContext>

<Border
	Background="#181818"
	CornerRadius="10"
	BorderBrush="#656565" 
	BorderThickness="1.5"
	>
    <Grid>
	<Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="36"/>
    </Grid.RowDefinitions>

	<Border 
		Padding="8"
		Grid.Row="0"
		Background="Transparent"
		CornerRadius="10,10,0,0"
		>
		<Grid >
			<Grid.RowDefinitions>
				<RowDefinition Height="40" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<TextBox 
				Grid.Row="0" 
				Name="SearchInput"
				KeyDown="SearchInput_KeyDown"
				Text="{Binding globalText, UpdateSourceTrigger=PropertyChanged}"/>
			
			<StackPanel 
				Name="ContentRoot"
				PreviewMouseWheel="OnPreviewMouseWheel"
				Grid.Row="1"
				>
				<ScrollViewer Name="InnerScrollViewer" Height="400">
					<StackPanel>
						<StackPanel 
							DataContext="{Binding ItemWallpaperView}"
							Name="Wallpaper_Panel" 
							Visibility="{Binding DataContext.PanelVisibility, RelativeSource={RelativeSource Self}}"	
							>
							<TextBlock
								Name="Label_Wallpaper"
								Text="Wallpaper"
								Foreground="#dfdfdf"
								Margin="12"
								FontWeight="Bold"
							/>

							<ListView 
								Margin="0,4"
								Focusable="True"
								Name="ListView_Wallpaper"
								IsTabStop="True"
								ScrollViewer.HorizontalScrollBarVisibility="Disabled"
								SelectedItem="{Binding selectedItem, Mode=TwoWay}"
								ItemsSource="{Binding wallpaperItems}">
								<ListView.ItemContainerStyle>
									<Style TargetType="{x:Type ListViewItem}">
										<EventSetter Event="MouseDoubleClick" Handler="ListViewWallpaperItem_MouseDoubleClick" />

										<Setter Property="Margin" Value="0,0,0,5" />
										<Setter Property="Width" Value="250"/>
            							<Setter Property="Height" Value="170"/>
									</Style>
								</ListView.ItemContainerStyle>

								<ListView.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel IsItemsHost="True"/>
									</ItemsPanelTemplate>
								</ListView.ItemsPanel>

								<ListView.InputBindings>
									<KeyBinding 
										Key="Enter"
										Command="{Binding OpenItemCommand}"
										CommandParameter="{Binding selectedItem}"
										/>
								</ListView.InputBindings>

								<ListView.ItemTemplate>
									<DataTemplate>
										<Border Margin="6">
											<Image Source="{Binding Thumbnail}"
												HorizontalAlignment="Center"
												VerticalAlignment="Center"
												Stretch="UniformToFill"/>
										</Border>
									</DataTemplate>
								</ListView.ItemTemplate>
							</ListView>
						</StackPanel>

						<StackPanel Name="Applications_Panel"
							DataContext="{Binding FilteredItemAppView}"
							Visibility="{Binding DataContext.PanelVisibility, RelativeSource={RelativeSource Self}}"
							VirtualizingPanel.IsVirtualizing="True"
							VirtualizingPanel.VirtualizationMode="Recycling"
							VirtualizingPanel.ScrollUnit="Pixel"
							>	
							<TextBlock
								Name="Label_Applications"
								Text="Applications"
								Foreground="#dfdfdf"
								Margin="12"
								FontWeight="Bold"
							/>

							<ListView 
								Margin="0,4"
								Focusable="True"
								Name="ListView_Applications"
								IsTabStop="True"
								ItemsSource="{Binding appItems}"
								VirtualizingPanel.IsVirtualizing="True"
								VirtualizingPanel.VirtualizationMode="Recycling"
								VirtualizingPanel.ScrollUnit="Pixel"
								KeyboardNavigation.DirectionalNavigation="Continue"
								Loaded="ResultsList_Loaded"

								SelectedItem="{Binding selectedItem, Mode=TwoWay}">
								<ListView.ItemContainerStyle>
									<Style TargetType="{x:Type ListViewItem}">
										<EventSetter Event="MouseDoubleClick" Handler="ListViewItem_MouseDoubleClick" />
										<Setter Property="Margin" Value="0,0,0,5" />
									</Style>
								</ListView.ItemContainerStyle>

								<ListView.InputBindings>
									<KeyBinding 
										Key="Enter"
										Command="{Binding OpenItemCommand}"
										CommandParameter="{Binding selectedItem}"
										/>
								</ListView.InputBindings>

								<ListView.ItemTemplate>
									<DataTemplate>
										<StackPanel Margin="4,0" Orientation="Horizontal">
											<Border CornerRadius="4" Background="#363636" Height="22" Width="22" Margin="0,0,10,0"/>
											<StackPanel>
												<TextBlock Text="{Binding title}" FontWeight="Bold" />
												<TextBlock Text="{Binding subTitle}" FontSize="12" Opacity="0.6" />
											</StackPanel>	
										</StackPanel>
									</DataTemplate>
								</ListView.ItemTemplate>
							</ListView>

						</StackPanel>
					</StackPanel>
				</ScrollViewer>
			</StackPanel>
		</Grid>
	</Border>
	<Border 
		Padding="1"
		Grid.Row="1"
		Background="#242424"
		CornerRadius="0,0,10,10"
		MouseLeftButtonDown="DragArea_MouseLeftButtonDown"
	>
		<TextBlock
			Foreground="#656565"
			Margin="8,6"
			MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
			Press <Span Background="#2f2f2f" Foreground="#878787">ESC</Span> to close
		</TextBlock>
	</Border>
	</Grid>
</Border>
</Window>
